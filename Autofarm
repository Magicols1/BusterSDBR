local vehModel, vehRoot, vehParts = nil, nil, {}
local lastVehScanT = 0
local function locateVehicle()
	local hp = pos(hrp()); if not hp then return nil end
	local vf = W:FindFirstChild("Vehicles"); if not vf then return nil end
	local best, bd
	local okc, kids = pcall(function() return vf:GetChildren() end); if not okc then return nil end
	for _, m in ipairs(kids) do
		local rp = m.PrimaryPart
		local sp0 = rp and pos(rp)
		if not sp0 then local oks, s = pcall(function() return m:FindFirstChildWhichIsA("VehicleSeat", true) end); if oks and s then sp0 = pos(s) end end
		if sp0 then local dd = (sp0 - hp).Magnitude; if dd < 16 and (not bd or dd < bd) then bd, best = dd, m end end
	end
	if not best then vehModel, vehRoot, vehParts = nil, nil, {}; return nil end
	vehModel = best
	local pp = best.PrimaryPart
	if not pp then local ok, s = pcall(function() return best:FindFirstChildWhichIsA("VehicleSeat", true) end); if ok then pp = s end end
	if not pp then local ok, b = pcall(function() return best:FindFirstChildWhichIsA("BasePart", true) end); if ok then pp = b end end
	vehRoot = pp
	vehParts = {}
	local okd, desc = pcall(function() return best:GetDescendants() end)
	if okd then for _, d in ipairs(desc) do if d:IsA("BasePart") then vehParts[#vehParts + 1] = d end end end
	return vehModel, vehRoot
end
local function findVehicle()
	if vehRoot then local ok, par = pcall(function() return vehRoot.Parent end); if ok and par then return vehModel, vehRoot end end
	vehModel, vehRoot = nil, nil
	if tick() - lastVehScanT < 0.15 then return nil end
	lastVehScanT = tick()
	return locateVehicle()
end
