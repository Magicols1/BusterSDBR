	while running and _G.__sdq == Q do
		if doneFn() then return true end
		if not nearHRP(sx, sy, sz, 5) then
			if tick() - lastLagT < 1.2 then status = loadstring(base64decode("bGFnYmFjayDigJQgd2FpdGluZyAxcw=="))(); wait(1.0) end
			status = loadstring(base64decode("cmUtcGF0aGluZyB0byBwcm9tcHQ="))(); moveTo(sx, sy, sz); aimCameraAt(ax, ay, az, 2.0)
