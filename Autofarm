local MAXV = 26
local POOL = {}
for _ = 1, MAXV do
    local b = mS(Color3.fromRGB(26, 26, 32), 20); sp(b, "Corner", 6); vis(b, false)
    local t = mT(Color3.fromRGB(225, 228, 236), 12, 21); vis(t, false)
    POOL[#POOL + 1] = { bg = b, txt = t }
end
local function popList()
    if itemOpen then local l = {}; for _, it in ipairs(ITEMS) do l[#l + 1] = it.name end return l end
    if vehOpen then return vehList end
    if missOpen then return MISS_OPTS end
    return nil
end
local function rowSelected(list, i)
    if itemOpen then return i == selItem end
    if vehOpen then return list[i] == selVeh end
    return list[i] == selMission
end
local function islandY() return py + ph + 6 end
local function islandRowY(i) return islandY() + 26 + (i - 1) * ISLROW end
local function layIsland()
    local open = (tab == 1) and (itemOpen or vehOpen or missOpen)
    local list = open and popList() or nil
    vis(U.islB, open); vis(U.islBg, open); vis(U.islT, open)
    if open and list then
        local n = math.min(#list, MAXV)
        local islH = 24 + math.max(#list, 1) * ISLROW + 8
        local iy0 = islandY()
        sp(U.islB, "Size", Vector2.new(pw + 2, islH + 2)); sp(U.islB, "Position", Vector2.new(px - 1, iy0 - 1))
        sp(U.islBg, "Size", Vector2.new(pw, islH)); sp(U.islBg, "Position", Vector2.new(px, iy0))
        local hdr = itemOpen and "Select item" or (vehOpen and "Select vehicle" or "Select mission")
        sp(U.islT, "Position", Vector2.new(px + 14, iy0 + 6)); sp(U.islT, "Text", hdr .. "  (" .. #list .. ")")
        for i = 1, MAXV do
            local show = i <= n
            vis(POOL[i].bg, show); vis(POOL[i].txt, show)
            if show then
                local iy = islandRowY(i)
                sp(POOL[i].bg, "Size", Vector2.new(pw - 24, 22)); sp(POOL[i].bg, "Position", Vector2.new(px + 12, iy))
                sp(POOL[i].bg, "Color", rowSelected(list, i) and Color3.fromRGB(46, 96, 64) or Color3.fromRGB(26, 26, 32))
                sp(POOL[i].txt, "Position", Vector2.new(px + 18, iy + 4)); sp(POOL[i].txt, "Text", tostring(list[i]))
            end
        end
    else
        for i = 1, MAXV do vis(POOL[i].bg, false); vis(POOL[i].txt, false) end
    end
end

local function lay()
    sp(U.bd, "Size", Vector2.new(pw + 2, ph + 2)); sp(U.bd, "Position", Vector2.new(px - 1, py - 1))
    sp(U.bg, "Size", Vector2.new(pw, ph)); sp(U.bg, "Position", Vector2.new(px, py))
    sp(U.title, "Position", Vector2.new(px + 14, py + 8)); sp(U.title, "Text", "Buster SDBR Autofarm")
    local halfT = (W2 - 6) / 2
    sp(U.tfB, "Size", Vector2.new(halfT, 22)); sp(U.tfB, "Position", Vector2.new(px + 12, py + Y_TABS)); sp(U.tfB, "Color", tab == 1 and Color3.fromRGB(70, 110, 90) or OFF)
    sp(U.tfT, "Position", Vector2.new(px + 12 + halfT / 2 - 14, py + Y_TABS + 4)); sp(U.tfT, "Text", "Farm")
    sp(U.tsB, "Size", Vector2.new(halfT, 22)); sp(U.tsB, "Position", Vector2.new(px + 12 + halfT + 6, py + Y_TABS)); sp(U.tsB, "Color", tab == 2 and Color3.fromRGB(70, 110, 90) or OFF)
    sp(U.tsT, "Position", Vector2.new(px + 12 + halfT + 6 + halfT / 2 - 16, py + Y_TABS + 4)); sp(U.tsT, "Text", "Stats")
    sp(U.div, "Size", Vector2.new(pw - 28, 1)); sp(U.div, "Position", Vector2.new(px + 14, py + 58))

    local farmOn = (tab == 1)
    for _, o in ipairs({ U.itB, U.itT, U.vhB, U.vhT, U.msB, U.msT, U.smB, U.smT, U.trB, U.trT, U.goB, U.goT }) do vis(o, farmOn) end
    for _, r in ipairs(SET) do vis(r.lbl, farmOn); vis(r.trk, farmOn); vis(r.fill, farmOn); vis(r.hnd, farmOn) end
    for _, o in ipairs(STAT) do vis(o, not farmOn) end

    if farmOn then
        sp(U.itB, "Size", Vector2.new(W2, 24)); sp(U.itB, "Position", Vector2.new(px + 12, py + Y_ITEM))
        sp(U.itT, "Position", Vector2.new(px + 18, py + Y_ITEM + 5)); sp(U.itT, "Text", "Item:  " .. ITEMS[selItem].name)
        sp(U.vhB, "Size", Vector2.new(W2, 24)); sp(U.vhB, "Position", Vector2.new(px + 12, py + Y_VEH))
        sp(U.vhT, "Position", Vector2.new(px + 18, py + Y_VEH + 5)); sp(U.vhT, "Text", "Vehicle:  " .. selVeh)
        sp(U.msB, "Size", Vector2.new(W2, 24)); sp(U.msB, "Position", Vector2.new(px + 12, py + Y_MISS))
        sp(U.msT, "Position", Vector2.new(px + 18, py + Y_MISS + 5)); sp(U.msT, "Text", "Mission:  " .. selMission)
        local half = (W2 - 6) / 2
        sp(U.smB, "Size", Vector2.new(half, 24)); sp(U.smB, "Position", Vector2.new(px + 12, py + Y_TOG)); sp(U.smB, "Color", smuggleOn and ON or OFF)
        sp(U.smT, "Position", Vector2.new(px + 12 + half / 2 - 32, py + Y_TOG + 5)); sp(U.smT, "Text", smuggleOn and "Smuggle: ON" or "Smuggle: OFF")
        sp(U.trB, "Size", Vector2.new(half, 24)); sp(U.trB, "Position", Vector2.new(px + 12 + half + 6, py + Y_TOG)); sp(U.trB, "Color", truckerOn and ON or OFF)
        sp(U.trT, "Position", Vector2.new(px + 12 + half + 6 + half / 2 - 30, py + Y_TOG + 5)); sp(U.trT, "Text", truckerOn and "Trucker: ON" or "Trucker: OFF")
        for i, r in ipairs(SET) do
            local ry = py + Y_SLIDER + (i - 1) * 26
            sp(r.lbl, "Position", Vector2.new(px + 14, ry)); sp(r.lbl, "Text", (r.n .. "   [ " .. r.f .. " ]"):format(r.g()))
            sp(r.trk, "Size", Vector2.new(W2, 5)); sp(r.trk, "Position", Vector2.new(px + 12, ry + 15))
            local f = frac(r.g(), r.mn, r.mx)
            sp(r.fill, "Size", Vector2.new(math.max(1, W2 * f), 5)); sp(r.fill, "Position", Vector2.new(px + 12, ry + 15))
            sp(r.hnd, "Size", Vector2.new(10, 16)); sp(r.hnd, "Position", Vector2.new(px + 12 + f * W2 - 5, ry + 9))
        end
        sp(U.goB, "Size", Vector2.new(W2, 28)); sp(U.goB, "Position", Vector2.new(px + 12, py + Y_GO))
        sp(U.goB, "Color", running and Color3.fromRGB(196, 54, 54) or ON)
        sp(U.goT, "Position", Vector2.new(px + 12 + W2 / 2 - 22, py + Y_GO + 6)); sp(U.goT, "Text", running and "STOP" or "START")
    else
        for i, o in ipairs(STAT) do sp(o, "Position", Vector2.new(px + 16, py + 66 + (i - 1) * 22)); sp(o, "Text", statRows[i] or "") end
    end
    sp(U.s1, "Position", Vector2.new(px + 14, py + Y_S1)); sp(U.s1, "Text", "Phase: " .. phase)
    sp(U.s2, "Position", Vector2.new(px + 14, py + Y_S2)); sp(U.s2, "Text", "Status: " .. status)
    layIsland()
end
