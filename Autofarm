local function aimCameraAt(tx, ty, tz, timeout)
	pcall(setrobloxinput, true); pcall(mouse2press)
	local t0, okF = tick(), 0
	while running and _G.__sdq == Q and tick() - t0 < (timeout or 2.5) do
		local ok, cf = pcall(function() return W.CurrentCamera.CFrame end)
		if ok and typeof(cf) == "CFrame" then
			local cp, look = cf.Position, cf.LookVector
			local wx, wy, wz = tx - cp.X, ty - cp.Y, tz - cp.Z
			local wl = math.sqrt(wx * wx + wy * wy + wz * wz)
			if wl > 0.1 then
				wx, wy, wz = wx / wl, wy / wl, wz / wl
				local lhl = math.sqrt(look.X * look.X + look.Z * look.Z)
				local whl = math.sqrt(wx * wx + wz * wz)
				local yawErr = 0
				if lhl > 1e-3 and whl > 1e-3 then
					local lx, lz = look.X / lhl, look.Z / lhl
					local hx, hz = wx / whl, wz / whl
					yawErr = math.atan2(lx * hz - lz * hx, lx * hx + lz * hz)
				end
				local pitchErr = math.asin(math.clamp(wy, -1, 1)) - math.asin(math.clamp(look.Y, -1, 1))
				if math.abs(math.deg(yawErr)) < 4 and math.abs(math.deg(pitchErr)) < 4 then
					okF = okF + 1; if okF >= 3 then break end
				else
					okF = 0
					local dx = math.clamp(yawErr * CamSens * camSignX, -CamMax, CamMax)
					local dy = math.clamp(pitchErr * CamSens * camSignY, -CamMax, CamMax)
					dx = math.floor(dx + (dx >= 0 and 0.5 or -0.5)); dy = math.floor(dy + (dy >= 0 and 0.5 or -0.5))
					if dx ~= 0 or dy ~= 0 then pcall(function() mousemoverel(dx, dy) end) end
				end
			end
		end
		task.wait()
	end
	pcall(mouse2release)
end

-- ==== PLAYER MOVEMENT ====
local tpHist = {}
local function tpWindowSum()
	local now = tick(); local keep, sum = {}, 0
	for _, e in ipairs(tpHist) do if now - e.t < 10 then keep[#keep + 1] = e; sum = sum + e.d end end
	tpHist = keep; return sum
end
local function tpBudgetWait(d)
	while running and _G.__sdq == Q and (tpWindowSum() + d) > FOOT_CAP * 10 do wait(0.1) end
	tpHist[#tpHist + 1] = { t = tick(), d = d }
end
local function moveTo(x, y, z)
	if TPFoot and not carryingGoods then
		local p0 = pos(hrp())
		if p0 then
			local ax, ay, az = x - p0.X, y - p0.Y, z - p0.Z
			local d0 = math.sqrt(ax * ax + ay * ay + az * az)
			if d0 > Arrive and d0 <= TPMAX then
				tpBudgetWait(d0)
				local h = hrp(); if h then pcall(function() h.CFrame = faceCF(x, y, z, ax, az) end) end
				wait(0.06)
				return true
			end
		end
	end
	local last = tick()
	while running and _G.__sdq == Q do
		local h = hrp(); local p = h and pos(h)
		if not p then task.wait(); last = tick() else
			local dx, dy, dz = x - p.X, y - p.Y, z - p.Z
			local d = math.sqrt(dx * dx + dy * dy + dz * dz)
			if d <= Arrive then return true end
			local now = tick(); local dt = now - last; last = now
			if dt <= 0 or dt > 0.1 then dt = 1 / 60 end
			local stepv = math.min(d, Speed * dt)
			pcall(function() h.CFrame = faceCF(p.X + dx / d * stepv, p.Y + dy / d * stepv, p.Z + dz / d * stepv, dx, dz) end)
			task.wait()
		end
	end
	return false
end
local function goNode(n) return moveTo(n[1], n[2], n[3]) end
local function teleportTo(n) local h = hrp(); if not h then return false end pcall(function() h.CFrame = CFrame.new(n[1], n[2], n[3]) end); wait(0.15); return true end
local function nearHRP(x, y, z, d)
	local p = pos(hrp()); if not p then return false end
	local dx, dy, dz = x - p.X, y - p.Y, z - p.Z
	return (dx * dx + dy * dy + dz * dz) <= d * d
end
local function ensureNear(x, y, z, d)
	local tries = 0
	while running and _G.__sdq == Q do
		if nearHRP(x, y, z, d) then return true end
		tries = tries + 1; if tries > 60 then return false end
		if tick() - lastLagT < 1.2 then status = "lagback — waiting 1s"; wait(1.0) end
		status = "re-pathing to prompt"; moveTo(x, y, z)
	end
	return false
end

-- ==== PROMPTS ====
local function promptPos(pr)
	local par = pr.Parent; if not par then return nil end
	local ok, wp = pcall(function() return par.WorldPosition end)
	if ok and typeof(wp) == "Vector3" then return wp end
	return pos(par)
end
local function nearestPrompt(maxD)
	local cp = pos(hrp()); if not cp then return nil end
	local best, bd, bp
	local root = W:FindFirstChild("Gameplay") or W
	local ok, desc = pcall(function() return root:GetDescendants() end)
	if ok then for _, d in ipairs(desc) do
		if d.ClassName == "ProximityPrompt" then
			local wp = promptPos(d); if wp then local dd = (wp - cp).Magnitude; if dd <= (maxD or 30) and (not bd or dd < bd) then bd, best, bp = dd, d, wp end end
		end
	end end
	return best, bp, bd
end
local function fireUntilAt(ax, ay, az, doneFn, progressFn, label, sx, sy, sz)
	sx, sy, sz = sx or ax, sy or ay, sz or az
	ensureNear(sx, sy, sz, 5)
	local h = hrp(); local p = h and pos(h)
	if p then pcall(function() h.CFrame = faceCF(p.X, p.Y, p.Z, ax - p.X, az - p.Z) end) end
	aimCameraAt(ax, ay, az, 1.3)
	wait(Settle)
	local stall, lastv = 0, progressFn()
	while running and _G.__sdq == Q do
		if doneFn() then return true end
		if not nearHRP(sx, sy, sz, 5) then
			if tick() - lastLagT < 1.2 then status = "lagback — waiting 1s"; wait(1.0) end
			status = "re-pathing to prompt"; moveTo(sx, sy, sz); aimCameraAt(ax, ay, az, 2.0)
		end
		status = label .. "  " .. tostring(progressFn())
		local h2 = hrp(); local p2 = h2 and pos(h2)
		if p2 then pcall(function() h2.CFrame = faceCF(p2.X, p2.Y, p2.Z, ax - p2.X, az - p2.Z) end) end
		keyDown(E); wait(FireHold); keyUp(E); wait(FireGap)
		local now = progressFn(); if now ~= lastv then stall, lastv = 0, now else stall = stall + 1 end
		if stall == 4 then aimCameraAt(ax, ay, az, 1.0) end
		if stall >= 6 then return false end
	end
	return false
end
local function tapPrompt(ax, ay, az, times)
	for _ = 1, times do
		if not running or _G.__sdq ~= Q then break end
		local h = hrp(); local p = h and pos(h)
		if p then pcall(function() h.CFrame = faceCF(p.X, p.Y, p.Z, ax - p.X, az - p.Z) end) end
		keyDown(E); wait(FireHold); keyUp(E); wait(0.15)
	end
end

