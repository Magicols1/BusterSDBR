			local tg = gB; if gA and (not tg or gA > tg) then tg = gA end
			if not tg then tg = lastGroundY end
			if tg then lastGroundY = tg; local ty = tg + Hover; if gB then ty = math.min(ty, gB + CAP) end vy = math.clamp((ty - p.Y) * YGAIN, -YMAX, YMAX) end
