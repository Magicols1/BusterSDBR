local function cycle()
	if not smuggleOn and not truckerOn then status = loadstring(base64decode("bm8gbW9kZSBlbmFibGVk"))(); wait(0.5); return true end
	local wantTruck = truckerOn and (pickMission() ~= nil)
	if truckerOn and not wantTruck then status = loadstring(base64decode("bm8gbWlzc2lvbiBhdmFpbGFibGU="))() end
	if not smuggleOn and not wantTruck then wait(5); return true end
	
	if smuggleOn then
		carryingGoods = false
		phase = loadstring(base64decode("Z3JhYiBpdGVtcw=="))()
		if not enterBuilding() then status = loadstring(base64decode("Y2FuJ3QgZW50ZXIgYnVpbGRpbmc="))(); return false end
		goNode(SPAWN); goNode(N_413); goNode(N_436)
		launderIfAny()
		local it = ITEMS[selItem]
		buyItem(it)
		if not running then return false end
		if not it.diablo then goNode(JUNCTION) end
		goNode(N_436); goNode(N_413); goNode(SPAWN)
	end
		phase = loadstring(base64decode("c3Bhd24gY2FyIDE="))()
	if not spawnVehicle() then status = loadstring(base64decode("c3Bhd24gIzEgZmFpbGVk"))(); return false end
		local haveTruck = false
	if wantTruck then
		phase = loadstring(base64decode("dHJ1Y2tlcjogdG8gTlBD"))()
		if flyDriveTo(TRUCK_EXIT[1], TRUCK_EXIT[3]) then
			exitVehicle()
			if doTruckMission() then
				phase = loadstring(base64decode("dHJ1Y2tlcjogZGVsaXZlcg=="))()
				if deliverTruck() then statMissions = statMissions + 1 end
				haveTruck = seated()
			else status = loadstring(base64decode("bWlzc2lvbiBzdGFydCBmYWlsZWQ="))() end
		else status = loadstring(base64decode("Y291bGRuJ3QgcmVhY2ggTlBD"))() end
	end
	
	if smuggleOn then
		phase = loadstring(base64decode("dG8gc2VsbGVy"))()
		if haveTruck then
			flyDriveTo(NSELLER[1], NSELLER[3]); exitVehicle()
		elseif seated() then
			if not flyRoute({ DNODE1, DNODE2, DNODE3 }) then return false end
			exitVehicle()
		else
			moveTo(NSELLER[1], NSELLER[2], NSELLER[3])
		end
		statSold = statSold + countSmuggled()
		phase = loadstring(base64decode("c2VsbA=="))(); sellAt(NSELLER)
		if not running then return false end
		phase = loadstring(base64decode("Y2FyIDIgLT4gYmFjaw=="))()
		if not spawnVehicle() then status = loadstring(base64decode("c3Bhd24gIzIgZmFpbGVk"))(); return false end
		if not flyRoute({ DNODE2, DNODE1, SPAWN }) then return false end
		exitVehicle()
		teleportTo(SPAWN)
	else
		if seated() then flyRoute({ DNODE2, DNODE1, SPAWN }) end
		if seated() then exitVehicle() end
		teleportTo(SPAWN)
	end
	statCycles = statCycles + 1
	sendReport((loadstring(base64decode("Q3ljbGUgJWQgZG9uZQ=="))()):format(statCycles), 3066993)
	return true
end
