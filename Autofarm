task.spawn(function()
    local wd, dpn, ox, oy, dRow, lastVL, lastStatT = false, false, 0, 0, 0, 0, 0
    while _G.__sdq == Q do
        if tick() - lastVL > 0.5 then refreshVehList(); lastVL = tick() end
