local function groundAt(x, oy, z)
	local ex = {}; if vehModel then ex[#ex + 1] = vehModel end; if LP.Character then ex[#ex + 1] = LP.Character end
	local params; pcall(function() params = RaycastParams.new(); params.FilterType = Enum.RaycastFilterType.Exclude; params.FilterDescendantsInstances = ex; params.IgnoreWater = true; params.RespectCanCollide = true end)
