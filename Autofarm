                "Income:  " .. fmtMoney(statIncome()),
                "Per hour:  " .. fmtMoney(statPerHr()),
                ("Runtime:  %02d:%02d:%02d"):format(math.floor(rt / 3600), math.floor((rt % 3600) / 60), math.floor(rt % 60)),
                "Cycles:  " .. statCycles,
                "Items sold:  " .. statSold,
                "Missions done:  " .. statMissions,
                "Lagbacks:  " .. lagCount,
                "Webhook:  " .. (WEBHOOK ~= "" and "SET (click = paste clipboard)" or "(copy URL then click)"),
            }
            lastStatT = tick()
        end
        local dn = ismouse1pressed()
        local mx, my = M.X, M.Y
        local halfT = (W2 - 6) / 2
        local half = (W2 - 6) / 2
        if dn and not wd then
            if itemOpen or vehOpen or missOpen then
                local list = popList()
                local n = list and math.min(#list, MAXV) or 0
                if mx >= px + 12 and mx <= px + pw - 12 then
                    for i = 1, n do
                        local iy = islandRowY(i)
                        if my >= iy and my <= iy + 22 then
                            if itemOpen then selItem = i elseif vehOpen then selVeh = list[i] else selMission = list[i] end
                            saveSettings()
                            break
                        end
                    end
                end
                itemOpen, vehOpen, missOpen = false, false, false
            elseif my >= py + Y_TABS and my <= py + Y_TABS + 22 then
                if mx >= px + 12 and mx <= px + 12 + halfT then tab = 1
                elseif mx >= px + 12 + halfT + 6 and mx <= px + 12 + halfT + 6 + halfT then tab = 2 end
            elseif tab == 2 and mx >= px + 12 and mx <= px + pw - 12 and my >= py + 238 and my <= py + 262 then
                local cb = readClipboard()
                if cb and (string.find(cb, "http", 1, true) or string.find(cb, "discord", 1, true)) then WEBHOOK = cb; saveSettings(); status = "webhook set from clipboard" else status = "clipboard has no URL (copy it first)" end
                if whBox then pcall(function() whBox.Text = WEBHOOK; whBox.Visible = true; whBox:CaptureFocus() end) end
            elseif tab == 1 and mx >= px + 12 and mx <= px + pw - 12 and my >= py + Y_ITEM and my <= py + Y_ITEM + 24 then
