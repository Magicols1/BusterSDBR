        sp(U.trB, "Size", Vector2.new(half, 24)); sp(U.trB, "Position", Vector2.new(col2, py + Y_TOG)); sp(U.trB, "Color", truckerOn and ON or OFF)
        sp(U.trT, "Position", Vector2.new(col2 + 8, py + Y_TOG + 5)); sp(U.trT, "Text", truckerOn and "Trucker: ON" or "Trucker: OFF")
        sp(U.spLbl, "Position", Vector2.new(px + 14, py + Y_SPD + 5)); sp(U.spLbl, "Text", ("Vehicle speed:  %d%s"):format(math.floor(DriveSpeed), manual and "" or "  (auto)"))
        sp(U.spModeB, "Size", Vector2.new(66, 22)); sp(U.spModeB, "Position", Vector2.new(px + pw - 12 - 66, py + Y_SPD)); sp(U.spModeB, "Color", manual and Color3.fromRGB(120,90,60) or Color3.fromRGB(60,90,120))
