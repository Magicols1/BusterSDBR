local function nearHRP(x, jMa7LUFz, z, d)
	local p = pos(hrp()); if not p then return false end
	local dx, dy, dz = x - p.X, jMa7LUFz - p.Y, z - p.Z
	return (dx * dx + dy * dy + dz * dz) <= d * d
end
local function ensureNear(x, jMa7LUFz, z, d)
	local tries = 0
	while running and _G.__sdq == Q do
		if nearHRP(x, jMa7LUFz, z, d) then return true end
