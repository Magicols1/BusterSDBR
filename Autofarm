task.spawn(function()
    local wd, dpn, ox, oy, dragSpd, lastVL, lastStatT = false, false, 0, 0, false, 0, 0
    local prevFarm = false
    while _G.__sdq == Q do
        if tick() - lastVL > 0.5 then refreshVehList(); lastVL = tick() end
        if tab == 2 and tick() - lastStatT > 0.4 then
            statMoney = readMoney() or statMoney
            local rt = statT0 > 0 and (tick() - statT0) or 0
            statRows = {
                "Money:  " .. fmtMoney(statMoney),
                "Income:  " .. fmtMoney(statIncome()),
                "Per hour:  " .. fmtMoney(statPerHr()),
                ("Runtime:  %02d:%02d:%02d"):format(math.floor(rt / 3600), math.floor((rt % 3600) / 60), math.floor(rt % 60)),
                "Cycles:  " .. statCycles,
                "Items sold:  " .. statSold,
                "Missions done:  " .. statMissions,
                "Lagbacks:  " .. lagCount,
                "Webhook:  " .. (webhookOn and (WEBHOOK ~= "" and ("ON, every " .. webhookEvery .. " cycles") or "ON but not set") or "OFF"),
            }
            lastStatT = tick()
        end
        local rbxAct = true; do local okA, vA = pcall(isrbxactive); if okA then rbxAct = (vA == true) end end
        if binding then
            local k = scanAnyKey()
            if k then hkFarm = k; binding = nil; saveSettings(); prevFarm = keyd(hkFarm) end
        else
            local gNow = keyd(hkFarm)
            if rbxAct and gNow and not prevFarm and not editingCyc then
                if running then stopFarm() else startFarm() end
            end
            prevFarm = gNow
        end
        if editingCyc then
            for di = 0, 9 do
                local down = keyd(DIGITS[di + 1]) or keyd(DIGITS[di + 11])
                if down and not prevDig[di] and #cycBuf < 3 then cycBuf = cycBuf .. tostring(di) end
                prevDig[di] = down
            end
            local bk = keyd(BACKSP)
            if bk and not prevBk and #cycBuf > 0 then cycBuf = cycBuf:sub(1, #cycBuf - 1) end
            prevBk = bk
            local ent = keyd(ENTER)
            if ent and not prevEnt then webhookEvery = math.clamp(tonumber(cycBuf) or webhookEvery, 1, 999); editingCyc = false; saveSettings() end
            prevEnt = ent
        end
        local dn = ismouse1pressed()
        local mx, my = M.X, M.Y
        local halfT = (W2 - 8) / 2
        local half = (W2 - 8) / 2
        local col2 = px + 12 + half + 8
        if dn and not wd then
            if nf.show then
                nf.show = false
            elseif itemOpen or vehOpen or missOpen then
                local list = popList()
                local n = list and math.min(#list, MAXV) or 0
                if mx >= px + 12 and mx <= px + pw - 12 then
                    for i = 1, n do
                        local iy = islandRowY(i)
                        if my >= iy and my <= iy + 22 then
                            if itemOpen then if not (isDiabloRow(i) and diabloLocked()) then selItem = i end
                            elseif vehOpen then selVeh = list[i] else selMission = list[i] end
                            saveSettings()
                            break
                        end
                    end
                end
                itemOpen, vehOpen, missOpen = false, false, false
            elseif my >= py + 32 and my <= py + 54 then
                if mx >= px + 12 and mx <= px + 12 + halfT then tab = 1
                elseif mx >= px + 12 + halfT + 8 and mx <= px + 12 + halfT + 8 + halfT then tab = 2 end
            elseif tab == 1 and mx >= px + 12 and mx <= px + pw - 12 and my >= py + Y_ITEM and my <= py + Y_ITEM + 24 then
                itemOpen = true
            elseif tab == 1 and mx >= px + 12 and mx <= px + pw - 12 and my >= py + Y_EC and my <= py + Y_EC + 24 then
                verifyElCapo()
            elseif tab == 1 and mx >= px + 12 and mx <= px + pw - 12 and my >= py + Y_VEH and my <= py + Y_VEH + 24 then
                vehOpen = true; refreshVehList()
            elseif tab == 1 and mx >= px + 12 and mx <= px + pw - 12 and my >= py + Y_MISS and my <= py + Y_MISS + 24 then
                missOpen = true
            elseif tab == 1 and my >= py + Y_TOG and my <= py + Y_TOG + 24 and mx >= px + 12 and mx <= px + 12 + half then
                smuggleOn = not smuggleOn; saveSettings()
            elseif tab == 1 and my >= py + Y_TOG and my <= py + Y_TOG + 24 and mx >= col2 and mx <= col2 + half then
                truckerOn = not truckerOn; saveSettings()
            elseif tab == 1 and my >= py + Y_SPD and my <= py + Y_SPD + 22 and mx >= px + pw - 12 - 66 and mx <= px + pw - 12 then
                driveMode = (driveMode == "A") and "M" or "A"; saveSettings()
            elseif tab == 1 and driveMode == "M" and mx >= px + 8 and mx <= px + 12 + (W2 - 78) and my >= py + Y_SPD + 15 and my <= py + Y_SPD + 31 then
                dragSpd = true
            elseif tab == 1 and my >= py + Y_WH and my <= py + Y_WH + 24 and mx >= px + 12 and mx <= px + 12 + half then
                webhookOn = not webhookOn; saveSettings()
            elseif tab == 1 and my >= py + Y_WH and my <= py + Y_WH + 24 and mx >= col2 and mx <= col2 + half then
                if whShow then whShow() end
            elseif tab == 1 and my >= py + Y_CYC and my <= py + Y_CYC + 24 and mx >= px + 14 + 128 and mx <= px + 14 + 128 + 38 then
                editingCyc = true; cycBuf = ""
            elseif tab == 1 and my >= py + Y_KEY and my <= py + Y_KEY + 24 and mx >= px + pw - 12 - 76 and mx <= px + pw - 12 then
                binding = "farm"
            elseif tab == 1 and mx >= px + 12 and mx <= px + pw - 12 and my >= py + Y_GO and my <= py + Y_GO + 28 then
                if running then stopFarm() else startFarm() end
            elseif my >= py and my <= py + 28 and mx >= px and mx <= px + pw then
                dpn = true; ox, oy = mx - px, my - py
            elseif editingCyc then
                webhookEvery = math.clamp(tonumber(cycBuf) or webhookEvery, 1, 999); editingCyc = false; saveSettings()
            end
        end
        if not dn and dragSpd then saveSettings() end
        if not dn then dpn = false; dragSpd = false end
        wd = dn
        if dpn then px, py = mx - ox, my - oy end
        if dragSpd then DriveSpeed = math.floor(60 + math.clamp((mx - (px + 12)) / (W2 - 78), 0, 1) * (400 - 60) + 0.5) end
        lay()
        task.wait()
    end
    for k, o in pairs(U) do
        if k == "nL" then for _, oo in ipairs(o) do sp(oo, "Visible", false) end else sp(o, "Visible", false) end
    end
    for _, e in ipairs(POOL) do sp(e.bg, "Visible", false); sp(e.txt, "Visible", false) end
    for _, o in ipairs(STAT) do sp(o, "Visible", false) end
end)
end
