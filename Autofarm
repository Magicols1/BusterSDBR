local function nearestDNode()
	local p = pos(hrp()); local DN = { DNODE1, DNODE2, DNODE3 }
	if not p then return 1 end
	local bi, bd = 1, nil
	for i, n in ipairs(DN) do
		local dx, dz = n[1] - p.X, n[3] - p.Z; local dd = dx * dx + dz * dz
		if not bd or dd < bd then bd, bi = dd, i end
	end
	return bi
end
