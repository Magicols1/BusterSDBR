local function nearestPrompt(maxD)
	local cp = pos(hrp()); if not cp then return nil end
	local best, bd, bp
	local root = W:FindFirstChild("Gameplay") or W
	local ok, desc = pcall(function() return root:GetDescendants() end)
	if ok then for _, d in ipairs(desc) do
		if d.ClassName == "ProximityPrompt" then
			local wp = promptPos(d); if wp then local dd = (wp - cp).Magnitude; if dd <= (maxD or 30) and (not bd or dd < bd) then bd, best, bp = dd, d, wp end end
		end
	end end
	return best, bp, bd
end
local function fireUntilAt(ax, ay, az, doneFn, progressFn, label, sx, sy, sz)
	sx, sy, sz = sx or ax, sy or ay, sz or az
	ensureNear(sx, sy, sz, 5)
	local h = hrp(); local p = h and pos(h)
	if p then pcall(function() h.CFrame = faceCF(p.X, p.Y, p.Z, ax - p.X, az - p.Z) end) end
	aimCameraAt(ax, ay, az, 1.3)
	wait(Settle)
	local stall, lastv = 0, progressFn()
	while on() do
		if doneFn() then return true end
		if not nearHRP(sx, sy, sz, 5) then
			if tick() - lastLagT < 1.2 then status = "Recovering"; wait(1.0) end
			status = "Repositioning"; moveTo(sx, sy, sz); aimCameraAt(ax, ay, az, 2.0)
		end
		status = label
		local h2 = hrp(); local p2 = h2 and pos(h2)
		if p2 then pcall(function() h2.CFrame = faceCF(p2.X, p2.Y, p2.Z, ax - p2.X, az - p2.Z) end) end
		keyDown(E); wait(FireHold); keyUp(E); wait(FireGap)
		local now = progressFn(); if now ~= lastv then stall, lastv = 0, now else stall = stall + 1 end
		if stall == 4 then aimCameraAt(ax, ay, az, 1.0) end
		if stall >= 6 then return false end
	end
	return false
end
local function tapPrompt(ax, ay, az, times)
	for _ = 1, times do
		if not running or _G.__sdq ~= Q then break end
		local h = hrp(); local p = h and pos(h)
		if p then pcall(function() h.CFrame = faceCF(p.X, p.Y, p.Z, ax - p.X, az - p.Z) end) end
		keyDown(E); wait(FireHold); keyUp(E); wait(0.15)
	end
end

