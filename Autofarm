local function cycle()
	if not smuggleOn and not truckerOn then status = "no mode enabled"; wait(0.5); return true end
	local wantTruck = truckerOn and (pickMission() ~= nil)
	if truckerOn and not wantTruck then status = "no mission available" end
	if not smuggleOn and not wantTruck then wait(5); return true end
	
	if smuggleOn then
		carryingGoods = false
		phase = "grab items"
		if not enterBuilding() then status = "can't enter building"; return false end
		goNode(SPAWN); goNode(N_413); goNode(N_436)
		launderIfAny()
		local it = ITEMS[selItem]
		buyItem(it)
		if not running then return false end
		if not it.diablo then goNode(JUNCTION) end
		goNode(N_436); goNode(N_413); goNode(SPAWN)
	end
		phase = "spawn car 1"
	if not spawnVehicle() then status = "spawn #1 failed"; return false end
		local haveTruck = false
	if wantTruck then
		phase = "trucker: to NPC"
		if flyDriveTo(TRUCK_EXIT[1], TRUCK_EXIT[3]) then
			exitVehicle()
			if doTruckMission() then
				phase = "trucker: deliver"
				if deliverTruck() then statMissions = statMissions + 1 end
				haveTruck = seated()
			else status = "mission start failed" end
		else status = "couldn't reach NPC" end
	end
	
	if smuggleOn then
		phase = "to seller"
		if haveTruck then
			flyDriveTo(NSELLER[1], NSELLER[3]); exitVehicle()
		elseif seated() then
			if not flyRoute({ DNODE1, DNODE2, DNODE3 }) then return false end
			exitVehicle()
		else
			moveTo(NSELLER[1], NSELLER[2], NSELLER[3])
		end
		statSold = statSold + countSmuggled()
		phase = "sell"; sellAt(NSELLER)
		if not running then return false end
		phase = "car 2 -> back"
		if not spawnVehicle() then status = "spawn #2 failed"; return false end
		if not flyRoute({ DNODE2, DNODE1, SPAWN }) then return false end
		exitVehicle()
		teleportTo(SPAWN)
	else
		if seated() then flyRoute({ DNODE2, DNODE1, SPAWN }) end
		if seated() then exitVehicle() end
		teleportTo(SPAWN)
	end
	statCycles = statCycles + 1
	sendReport(("Cycle %d done"):format(statCycles), 3066993)
	return true
end
