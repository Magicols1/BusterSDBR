local function faceCF(x, y, z, dx, dz)
	local l = math.sqrt(dx * dx + dz * dz); if l < 1e-3 then return CFrame.new(x, y, z) end
	dx, dz = dx / l, dz / l
	return CFrame.new(x, y, z, -dz, 0, -dx, 0, 1, 0, dx, 0, -dz)
end
local function readMoney()
	local ls = LP:FindFirstChild("leaderstats")
	if ls then for _, n in ipairs({ "Cash", "Money", "Bank", "Dollars", "Balance" }) do
		local v = ls:FindFirstChild(n); if v then local ok, val = pcall(function() return v.Value end); if ok and type(val) == "number" then return val end end
	end end
	for _, n in ipairs({ "Money", "Cash", "Bank", "Balance" }) do
		local ok, val = pcall(function() return LP:GetAttribute(n) end); if ok and type(val) == "number" then return val end
	end
	local lbl = nav(LP:FindFirstChild("PlayerGui"), "MainHUDGui", "TopRight", "Money", "TextLabel")
	if lbl then
		local ok, t = pcall(function() return lbl.Text end)
		if ok and type(t) == "string" then
			local num, suf = t:match("([%d%.]+)%s*([KkMmBb]?)")
			local val = num and tonumber(num)
			if val then
				local u = suf:upper()
				if u == "K" then val = val * 1e3 elseif u == "M" then val = val * 1e6 elseif u == "B" then val = val * 1e9 end
				return val
			end
		end
	end
	return nil
end
local function commas(n)
	local sgn = n < 0 and "-" or ""
	local str = tostring(math.floor(math.abs(n) + 0.5))
	while true do local a, k = str:gsub("^(%d+)(%d%d%d)", "%1,%2"); str = a; if k == 0 then break end end
	return sgn .. str
end
local function fmtMoney(n)
	if type(n) ~= "number" then return "?" end
	local a, sgn = math.abs(n), (n < 0 and "-" or "")
	if a >= 1e9 then return sgn .. "$" .. ((("%.2f"):format(a / 1e9)):gsub("%.?0+$", "")) .. "B" end
	if a >= 1e6 then return sgn .. "$" .. ((("%.2f"):format(a / 1e6)):gsub("%.?0+$", "")) .. "M" end
	if a >= 1e3 then return sgn .. "$" .. ((("%.1f"):format(a / 1e3)):gsub("%.?0+$", "")) .. "K" end
	return sgn .. "$" .. commas(a)
end
